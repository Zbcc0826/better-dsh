{
  "name": "dsh-friction-drive",
  "version": "0.2.5",
  "description": "DeepSeek Harness 本地插件（dsh-friction-drive）：记录当前会话的工具摩擦，并在用户同意后安装替代工具或沉淀程序，原工具定义不变。可能增加 token 消耗。",
  "type": "module",
  "private": true,
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh-bundle",
    "dsh-friction-drive"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zbcc0826/better-dsh.git"
  },
  "homepage": "https://github.com/Zbcc0826/better-dsh",
  "icon": "./icon.svg",
  "main": "./packages/dsh-friction-drive/index.js",
  "exports": {
    ".": "./packages/dsh-friction-drive/index.js",
    "./demo": "./packages/dsh-friction-demo/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "icon.svg",
    "locale",
    "packages/dsh-friction-drive",
    "packages/dsh-friction-demo",
    "install.mjs",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "engines": { "dsh": ">=0.2.2-rc.3 <0.3.0" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.3 <0.2.3 || >=0.2.3-0 <0.2.4-0 || >=0.2.4-0 <0.2.5-0 || >=0.2.5-0 <0.2.6-0 || >=0.2.6-0 <0.2.7-0 || >=0.2.7-0 <0.2.8-0 || >=0.2.8-0 <0.2.9-0 || >=0.2.9-0 <0.3.0-0"
  }
}
